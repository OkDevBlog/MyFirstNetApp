<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:Width="400" d:Height="250"
             x:Class="MyCrossApp.Views.MainView">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="15">
        <!-- TextBlock مع اسم لسهولة التحكم به -->
        <TextBlock x:Name="MyMessageText" 
                   Text="Welcome! Click the button below." 
                   FontSize="16" 
                   TextAlignment="Center"
                   HorizontalAlignment="Center"/>

        <!-- Button التفاعلي -->
        <Button Content="Click Me" 
                Click="Button_Click" 
                HorizontalAlignment="Center"
                Padding="12,6"/>
    </StackPanel>
</UserControl>